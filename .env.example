# Copy this file to .env and replace the placeholder password locally.
# Never commit .env. The application reads DATABASE_URL at startup and does not
# store the password in Git.
DATABASE_URL=postgres://baccarat_app:CHANGE_ME@127.0.0.1:5432/baccarat_simulator?sslmode=disable

# Optional. The host must stay on the loopback interface.
ADDR=127.0.0.1:8080
